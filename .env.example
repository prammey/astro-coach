# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it stays out of git.

# Found in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Also from Project Settings → API, under "service_role".
# SERVER-ONLY. This key bypasses Row Level Security, so it must never be
# prefixed with NEXT_PUBLIC_ or referenced from a Client Component.
# Required for permanently deleting an account ("Deactivate Account").
SUPABASE_SERVICE_ROLE_KEY=""

# Found in Supabase Dashboard → Project Settings → Database
# DATABASE_URL: pooled "Transaction" connection string — used at runtime.
# DIRECT_URL: direct (non-pooled) connection string — used by Prisma
# migrations, which need a direct connection.
DATABASE_URL=""
DIRECT_URL=""

# SERVER-ONLY. Comma-separated emails allowed to open /admin/reports.
# Leave empty and nobody has admin access — a missing value locks the
# admin pages rather than opening them.
# Emails allowed to open /admin/reports (server-only).
ADMIN_EMAILS=""

# SERVER-ONLY. Optional: emails you when someone reports a problem with a
# question. Without these, reports are still saved and readable at
# /admin/reports — you just don't get notified.
# RESEND_API_KEY: from https://resend.com (free tier is plenty).
# REPORT_EMAIL_TO: where notifications are sent.
# REPORT_EMAIL_FROM: defaults to Resend's shared sender, which works
#   without verifying a domain. Set it once you have your own domain.
RESEND_API_KEY=""
REPORT_EMAIL_TO=""
REPORT_EMAIL_FROM=""

# ---------------------------------------------------------------------------
# ASTRO COACH PRO
#
# Everything below is needed for the paid product: subscriptions, AI grading
# and the admin FRQ importer. Names only — never commit real values.
# Nothing here is prefixed NEXT_PUBLIC_, because none of it may reach a
# browser. The only Pro values the browser knows (advertised prices, the
# founding deadline) are hardcoded in src/lib/pro/public-config.ts.
# ---------------------------------------------------------------------------

# --- Stripe (TEST MODE) ----------------------------------------------------
# SERVER-ONLY. From Stripe Dashboard → Developers → API keys, with the
# "Test mode" toggle ON. A test key starts with sk_test_.
# Do NOT put a live key (sk_live_) here — /admin/usage warns loudly if you do.
STRIPE_SECRET_KEY=""

# From Stripe Dashboard → Developers → Webhooks, after adding the endpoint
# <your site>/api/stripe/webhook. Starts with whsec_.
# Without this the webhook route refuses every request, so nobody becomes Pro.
STRIPE_WEBHOOK_SECRET=""

# The two recurring monthly Price IDs, both created in test mode.
# Founding: $5.99/month. Regular: $7.99/month. Both start with price_.
# Checkout picks between them from the server clock — see PRO_FOUNDING_CUTOFF.
STRIPE_FOUNDING_PRICE_ID=""
STRIPE_REGULAR_PRICE_ID=""

# --- AI grading ------------------------------------------------------------
# SERVER-ONLY. From https://aistudio.google.com/apikey
# With this unset the app uses a deterministic mock grader locally, so you
# can develop the whole flow without spending anything. Production refuses
# to fall back to the mock grader.
GEMINI_API_KEY=""

# Optional. "gemini" or "mock" — leave unset to pick automatically based on
# whether GEMINI_API_KEY is present.
AI_GRADING_PROVIDER=""

# Optional. Defaults to gemini-2.5-flash. If you set a model that is not in
# the rates table in src/lib/pro/config.ts, cost estimates show as unknown
# rather than as a wrong number.
AI_GRADING_MODEL=""

# --- Admin -----------------------------------------------------------------
# SERVER-ONLY. Comma-separated Supabase Auth user UUIDs allowed into /admin
# and the FRQ importer. Find yours in Supabase Dashboard → Authentication →
# Users → click your user → "User UID".
# Unset means nobody is an admin, so a missing value locks the admin area
# rather than opening it. This is separate from ADMIN_EMAILS above, which
# still controls the older /admin/reports page.
ADMIN_USER_IDS=""

# --- Site ------------------------------------------------------------------
# The absolute base URL, used to build Stripe return URLs.
# Local: http://localhost:3000 — Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=""

# --- Founding price cutoff -------------------------------------------------
# Optional override, for testing what happens after the founding period ends.
# Defaults to 2027-01-01T06:00:00Z (the end of 31 December 2026).
PRO_FOUNDING_CUTOFF=""
